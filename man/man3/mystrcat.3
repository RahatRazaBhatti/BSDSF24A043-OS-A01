.TH MYSTRCAT 3 "2026-09-23" "libmyutils 1.0" "libmyutils Manual"
.SH NAME
mystrcat \- concatenate two strings
.SH SYNOPSIS
.nf
#include "mystrfunctions.h"

int mystrcat(char* dest, const char* src);
.fi
.SH DESCRIPTION
Appends the string src to the end of dest. The caller must ensure dest has enough space. Returns the new length of dest.
