.TH MYSTRLEN 3 "2026-09-23" "libmyutils 1.0" "libmyutils Manual"
.SH NAME
mystrlen \- calculate the length of a string
.SH SYNOPSIS
.nf
#include "mystrfunctions.h"

int mystrlen(const char* s);
.fi
.SH DESCRIPTION
Returns the number of characters in the string s, not counting the terminating null byte.
